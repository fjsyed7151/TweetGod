# ============================================================================
# TweetGod — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env to git — it contains secrets.
# ============================================================================

# ── OpenRouter (LLM polishing — replaces direct xAI Grok) ──────────────────
# Get this from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model id on OpenRouter. Default maps to xAI's grok-4-1-fast-non-reasoning.
OPENROUTER_MODEL=x-ai/grok-4.1-fast

# ── Typefully (posting + analytics) ────────────────────────────────────────
# Get this from https://typefully.com/settings/integrations
TYPEFULLY_API_KEY=
# Optional: pin a social set id. If left blank, the bot auto-discovers the
# first X-enabled social set on first post and caches it for the process.
TYPEFULLY_SOCIAL_SET_ID=

# ── Supabase (database) ────────────────────────────────────────────────────
# From your Supabase project → Settings → API.
# Use the "secret" / service_role key — the bot needs write access.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# ── Telegram Bot (approval flow + notifications) ───────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Message your bot, then visit:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    to find your chat_id in the response JSON.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Apify (tweet scraping) ─────────────────────────────────────────────────
# Get this from https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────────
# Sentry error tracking (leave blank to skip)
SENTRY_DSN=
