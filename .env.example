# ============================================================================
# TweetGod — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env to git — it contains secrets.
# ============================================================================

# ── Twitter API (v2 Free Tier) ──────────────────────────────────────────────
# Get these from https://developer.x.com/en/portal/dashboard
# You need a project with "Read and Write" permissions.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# ── xAI Grok (LLM for polishing your tweets) ───────────────────────────────
# Get this from https://console.x.ai/
XAI_API_KEY=

# ── Supabase (database) ────────────────────────────────────────────────────
# Get these from your Supabase project → Settings → API
# Use the "service_role" key (not anon) — the bot needs write access.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# ── Telegram Bot (approval flow + notifications) ───────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Message your bot, then visit:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    to find your chat_id in the response JSON.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Apify (tweet scraping) ─────────────────────────────────────────────────
# Get this from https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────────
# Sentry error tracking (leave blank to skip)
SENTRY_DSN=
